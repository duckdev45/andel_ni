/**
 * Wrangler 設定：https://developers.cloudflare.com/workers/wrangler/configuration/
 * 前台（React Router SSR）與之後的 API（Hono）跑在同一個 Worker（規格 D3）。
 * D1 / R2 / staging 環境之後接後端時再加（規格 11.2）。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andelni",
  "compatibility_date": "2026-10-19",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // 後台登入頻率限制：同一 IP 每分鐘 5 次（workers/auth/admin.ts）
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
