/**
 * Wrangler 設定：https://developers.cloudflare.com/workers/wrangler/configuration/
 * 前台（React Router SSR）與 API（Hono，/api/*）跑在同一個 Worker（規格 D3）。
 *
 * 環境（規格 11.2）：
 *   正式   andelni           ← main 分支（Workers Builds）
 *   staging andelni-staging  ← dev 分支；建置時設 CLOUDFLARE_ENV=staging
 * D1、R2、rate limit 等 binding 不會繼承，staging 要各寫一份。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andelni",
  "compatibility_date": "2026-10-19",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "andelni",
      "database_id": "d89704d8-d026-467a-8c65-b7ff46a2a2e7",
      "migrations_dir": "migrations",
    },
  ],
  // 商品照片（規格 5.2）；網址 /img/<key>，由 workers/app.ts 讀出
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "andelni-images" }],
  // 後台登入頻率限制：同一 IP 每分鐘 5 次（workers/auth/admin.ts）
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    // 會員註冊、登入：同一 IP 每分鐘 10 次（workers/api/auth.ts）
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "env": {
    "staging": {
      "name": "andelni-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "andelni-staging",
          "database_id": "ea62acdc-3f03-4119-bce0-5e3be7ad6925",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "IMAGES", "bucket_name": "andelni-images-staging" },
      ],
      "ratelimits": [
        {
          "name": "ADMIN_LOGIN_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "LOGIN_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
