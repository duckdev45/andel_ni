/**
 * Wrangler 設定：https://developers.cloudflare.com/workers/wrangler/configuration/
 * 前台（React Router SSR）與 API（Hono，/api/*）跑在同一個 Worker（規格 D3）。
 *
 * 環境（規格 11.2）：
 *   正式   andelni           ← main 分支（Workers Builds）  andelni.com、www.andelni.com
 *   staging andelni-staging  ← dev 分支；建置時設 CLOUDFLARE_ENV=staging  staging.andelni.com
 * D1、R2、rate limit 等 binding 不會繼承，staging 要各寫一份。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andelni",
  "compatibility_date": "2026-10-19",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // 自訂網域（部署時自動建 DNS 與憑證）；www 由 workers/app.ts 轉到 andelni.com
  "routes": [
    { "pattern": "andelni.com", "custom_domain": true },
    { "pattern": "www.andelni.com", "custom_domain": true },
  ],
  // 每 15 分鐘：逾時未付款訂單自動取消（app/lib/db/orders.server.ts expireOrders）
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "andelni",
      "database_id": "d89704d8-d026-467a-8c65-b7ff46a2a2e7",
      "migrations_dir": "migrations",
    },
  ],
  // 商品照片（規格 5.2）：正式 img.andelni.com、staging img-staging.andelni.com（R2 自訂網域）；本機走 /img/
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "andelni-images" }],
  // 後台登入頻率限制：同一 IP 每分鐘 5 次（workers/auth/admin.ts）
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    // 會員註冊、登入：同一 IP 每分鐘 10 次（workers/api/auth.ts）
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "env": {
    "staging": {
      "name": "andelni-staging",
      // 綠界用公開的測試特店（workers/api/ecpay.ts）；正式站的金鑰用 wrangler secret put 設定
      "vars": { "ECPAY_MODE": "stage" },
      "routes": [{ "pattern": "staging.andelni.com", "custom_domain": true }],
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "andelni-staging",
          "database_id": "ea62acdc-3f03-4119-bce0-5e3be7ad6925",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "IMAGES", "bucket_name": "andelni-images-staging" },
      ],
      "ratelimits": [
        {
          "name": "ADMIN_LOGIN_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "LOGIN_LIMIT",
          "namespace_id": "1004",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
