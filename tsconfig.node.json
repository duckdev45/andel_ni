{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "workers/auth/**/*.ts",
    "workers/api/admin-input*.ts",
    "workers/api/order-input*.ts",
    "workers/api/ecpay*.ts",
    "workers/mail.ts",
    "scripts/**/*.ts",
    "app/lib/catalog.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  }
}
